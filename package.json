{
  "name": "dsh-plugin-mumu",
  "version": "0.2.3",
  "private": true,
  "description": "MuMu 模拟器控制：给 DeepSeek Harness 注入 mumu_* 工具（看屏幕 / 点 / 滑 / 按键 / Android shell / 等画面变化 / OCR / 装包 / 多开寻址）和 mumu-skill。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/mumu-worker.ps1",
    "lib/mumu-ocr.ps1",
    "lib/winrt/*.dll",
    "lib/winrt/README.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skill/**",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mumu",
    "android-emulator",
    "automation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
